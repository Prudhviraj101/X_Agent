# X-Agent — Configuration template
# Copy this file to .env and fill in your values.
# Never commit .env or real credentials.

# LLM provider: openai | gemini | hybrid | nvidia
MODEL_PROVIDER=hybrid

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

HYBRID_RESEARCHER_MODEL=gemini-3.5-flash
HYBRID_WRITER_MODEL=gpt-4o-mini

# X posting. Keep false while testing.
POST_TO_X=false

# Preferred local CLI/session route
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Optional X API v2 OAuth fallback
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional Twitter/X source
SCRAPE_TWITTER=false

# Optional Reddit authenticated scraping
REDDIT_SESSION_COOKIE=

# Scheduler / HITL
SCRAPE_INTERVAL_HOURS=1
MAX_POSTS_PER_RUN=3
HITL=true
HITL_PORT=8080
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PEAK_HOURS=9,12,17,21

# Deduplication / HTTP
DEDUP_TTL_HOURS=48
REDDIT_SUBREDDITS=MachineLearning,artificial,LocalLLaMA,singularity,AItools,ChatGPT
HTTP_TIMEOUT=15
USER_AGENT=XAgentBot/1.0 (+https://github.com/Prudhviraj101/X_Agent)
