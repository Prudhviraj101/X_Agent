# ─────────────────────────────────────────────────────────────────────────────
# X Agent — Configuration template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose "openai" | "gemini" | "hybrid"
#   hybrid = best-of-both: Gemini (researcher) cleans the facts,
#            then GPT-4o-mini (writer) turns them into the X post.
MODEL_PROVIDER=hybrid

# OpenAI settings (used when MODEL_PROVIDER=openai, and always as the hybrid writer)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini settings (used when MODEL_PROVIDER=gemini, and always as the
# hybrid researcher)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash

# Hybrid stage overrides (optional — defaults shown):
HYBRID_RESEARCHER_MODEL=gemini-3.5-flash
HYBRID_WRITER_MODEL=gpt-4o-mini

# ── X / Twitter POSTING ───────────────────────────────────────────────────────
# FREE route (default): uses twitter-cli with your TWITTER_AUTH_TOKEN/TWITTER_CT0
# from the Twitter Scraping section above — no paid API needed. Just:
#   POST_TO_X=true
# and make sure TWITTER_AUTH_TOKEN + TWITTER_CT0 are set.
#
# Media: scraped images are attached automatically when a source has them.
# Set NANOBANANA=true to also auto-generate an image (Gemini 2.5 Flash Image /
# "Nano Banana") for posts that have none. Requires Gemini image quota.
NANOBANANA=false
#
# Paid (optional) fallback — Twitter API v2 OAuth, requires Basic tier+:
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Set to "true" to actually post to X. Uses twitter-cli (free) first, then OAuth.
POST_TO_X=false

# ── Twitter Scraping via twitter-cli (Agent-Reach backend) ───────────────────
# Enables reading/searching trending AI tweets as an additional content source.
#
# Setup:
#   1. pip install twitter-cli  (already installed at v0.8.5)
#   2. Be logged into x.com in Arc / Chrome / Edge / Firefox / Brave.
#      twitter-cli AUTO-EXTRACTS the full cookie set from the browser.
#      Use a dedicated scraping account — not your main account — to avoid
#      ban risk per Agent-Reach docs.
#   3. Keep the browser logged in, then verify:  twitter whoami
#
# NOTE: the TWITTER_AUTH_TOKEN/TWITTER_CT0 env-var pair below is OPTIONAL and
# NOT used by search (v0.8.5 needs the full cookie set, browser-extracted).
# Leave them blank to rely on browser extraction.
#
# Leave SCRAPE_TWITTER=false to skip this source (default — no twitter-cli needed)
SCRAPE_TWITTER=false
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# ── Reddit Scraping ───────────────────────────────────────────────────────────
# Reddit has NO anonymous/zero-config scraping path as of 2025-11
# (confirmed by Agent-Reach's channels/reddit.py analysis).
# Anonymous .json endpoints return 403; the official API requires manual approval.
#
# The agent tries:
#   1. curl_cffi Chrome TLS fingerprint impersonation (best unauthenticated attempt)
#   2. rdt-cli with your reddit_session cookie (Agent-Reach's rdt-cli backend)
#   3. Reddit RSS feed fallback
#
# For best results with rdt-cli (Agent-Reach approach):
#   1. pipx install "git+https://github.com/public-clis/rdt-cli.git"
#   2. Run: rdt login
#      OR manually set your reddit_session cookie below (from Cookie-Editor on reddit.com)
REDDIT_SESSION_COOKIE=

# ── Scheduler & Queue ────────────────────────────────────────────────────────
# How often the agent runs to fill the draft queue (in hours)
SCRAPE_INTERVAL_HOURS=1

# Maximum number of tweets to draft per scrape cycle
MAX_POSTS_PER_RUN=3

# Human-In-The-Loop Approval (HITL) Dashboard
# When true, drafts must be approved at http://localhost:8080 before posting
HITL=true
HITL_PORT=8080

# Telegram HITL (Optional)
# If both are set, the agent will send drafts to Telegram and you can click Approve/Reject
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduled posting hours (24h format, local timezone)
PEAK_HOURS=9,12,17,21


# ── Deduplication ────────────────────────────────────────────────────────────
# How long to remember a URL before allowing it again (hours)
DEDUP_TTL_HOURS=48

# ── Scraper behaviour ────────────────────────────────────────────────────────
# Comma-separated subreddits to monitor
REDDIT_SUBREDDITS=MachineLearning,artificial,LocalLLaMA,singularity,AItools,ChatGPT

# HTTP request timeout in seconds
HTTP_TIMEOUT=15

# Custom user-agent sent with HTTP requests (Reddit requires a unique one)
USER_AGENT=XAgentBot/1.0 (+https://github.com/your-username/x-agent)
